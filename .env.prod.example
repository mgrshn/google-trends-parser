# Прод-конфиг парсера. Скопируй в .env и заполни. .env в git НЕ коммитить.

# Логи: только ошибки в проде
LOG_LEVEL=error

# --- PostgreSQL (внутри docker-сети, наружу не торчит) ---
POSTGRES_DB=trends
POSTGRES_USER=trends
# СМЕНИ на длинный случайный пароль: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_long_random_password
# DSN должен совпадать с POSTGRES_* выше (host = имя сервиса 'postgres')
DB_DSN=postgresql://trends:CHANGE_ME_long_random_password@postgres:5432/trends

# --- Redis (внутри docker-сети) ---
REDIS_URL=redis://redis:6379

# --- API ---
# ОБЯЗАТЕЛЬНО задать: без ключа API открыт всем. openssl rand -hex 32
API_KEY=CHANGE_ME_api_key
WAIT_TIMEOUT_SEC=30
# 0.0.0.0 = доступен снаружи (нужен firewall!). Если discovery на этом же сервере — 127.0.0.1
API_BIND=0.0.0.0

# --- Масштаб ---
WORKER_CONCURRENCY=24
WORKER_REPLICAS=1
UVICORN_WORKERS=2